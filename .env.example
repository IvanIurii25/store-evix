# Copy to .env and adjust. Never commit the real .env.

APP_ENV=local
LOG_LEVEL=INFO

# asyncpg driver is required (postgresql+asyncpg://...)
# Host port is 55432 (compose maps 55432->5432 to avoid clashing with a local Postgres).
DATABASE_URL=postgresql+asyncpg://evix:evix@localhost:55432/evix_store

# Connection pool (§5.3 defaults)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Auth / JWT (§7). Generate a strong secret for real environments.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Redis (refresh blacklist / rate-limit). Host port 56379 (compose 56379->6379).
REDIS_URL=redis://localhost:56379/0

# Store config (§2.6)
CURRENCY=MDL
DEFAULT_LANG=ro
COURIER_RATE=50
# FREE_DELIVERY_FROM=1000    # optional: free courier over this subtotal
TAX_PERCENT=0

# --- MVP prod-hardening (W7) ---
# CORS: comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:4321,http://localhost:3000

# Media storage: local (var/media) | s3 (MinIO/S3). Host MinIO API port 59000.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:59000
S3_ACCESS_KEY=evixminio
S3_SECRET_KEY=evixminio-secret
S3_BUCKET=evix-media
S3_PUBLIC_URL=http://localhost:59000/evix-media

# Email: console (log) | smtp. MailHog SMTP host port 51025, UI 58025.
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=51025
EMAIL_FROM=orders@evix.md

# Rate limiting (Redis), "<count>/<window_seconds>".
RATE_LIMIT_LOGIN=5/60
RATE_LIMIT_CHECKOUT=10/60
